    <script type="module">

        //================================================
        // GAME DATA (Simulated JSON)
        //================================================
        
        const GAME_DATA = {
            // TIER 1: Common
            // TIER 2: Uncommon
            // TIER 3: Rare
            // TIER 4: Military / Ultra-Rare
            ITEMS: {
                // T1 Materials
                "SCRAP_METAL": { name: "Scrap Metal", stack: 50, type: "MATERIAL" },
                "WOOD": { name: "Wood", stack: 50, type: "MATERIAL" },
                "CLOTH": { name: "Cloth", stack: 50, type: "MATERIAL" },
                "NAILS": { name: "Nails", stack: 100, type: "MATERIAL" },
                "STONE": { name: "Stone", stack: 50, type: "MATERIAL" },
                "EMPTY_BOTTLE": { name: "Empty Bottle", stack: 10, type: "MATERIAL" },
                
                // T2 Materials
                "STEEL_PIPE": { name: "Steel Pipe", stack: 20, type: "MATERIAL" },
                "PLANKS": { name: "Planks", stack: 30, type: "MATERIAL" },
                "LEATHER": { name: "Leather", stack: 20, type: "MATERIAL" },
                "SCREWS": { name: "Screws", stack: 100, type: "MATERIAL" },
                "GAS_CAN": { name: "Gas Can", stack: 1, type: "MATERIAL", use: (player) => {
                    if (player.vehicle) {
                        const amount = 20;
                        const needed = player.vehicle.maxFuel - player.vehicle.fuel;
                        const added = Math.min(amount, needed);
                        player.vehicle.fuel += added;
                        game.showMessage(`Refueled vehicle for ${added}L.`);
                        if (added === amount) return true; // Consume item
                        else return false; // Don't consume, can is not empty
                    } else {
                        game.showMessage("No vehicle to refuel.");
                        return false;
                    }
                }},
                "HOTWIRE_KIT": { name: "Hotwire Kit", stack: 5, type: "TOOL" },
                "VEHICLE_KEY": { name: "Vehicle Key", stack: 1, type: "TOOL" },

                // T3 Materials
                "STEEL_PLATE": { name: "Steel Plate", stack: 10, type: "MATERIAL" },
                "CONCRETE_MIX": { name: "Concrete Mix", stack: 10, type: "MATERIAL" },
                "KEVLAR": { name: "Kevlar", stack: 10, type: "MATERIAL" },
                "ELECTRONICS": { name: "Electronics", stack: 20, type: "MATERIAL" },
                
                // T4 Materials
                "TITANIUM_PLATE": { name: "Titanium Plate", stack: 5, type: "MATERIAL" },
                "CARBON_FIBER": { name: "Carbon Fiber", stack: 10, type: "MATERIAL" },
                "ADV_CIRCUIT": { name: "Adv. Circuitry", stack: 10, type: "MATERIAL" },
                
                // T1 Food
                "CANNED_FOOD": { name: "Canned Food", stack: 10, type: "FOOD", use: (p) => { p.hunger += 30; return true; }},
                "WATER_BOTTLE": { name: "Water Bottle", stack: 10, type: "FOOD", use: (p) => { p.thirst += 40; return true; }},
                "CHIPS": { name: "Chips", stack: 10, type: "FOOD", use: (p) => { p.hunger += 10; return true; }},
                
                // T2 Food
                "MRE": { name: "MRE", stack: 5, type: "FOOD", use: (p) => { p.hunger += 80; p.thirst += 20; return true; }},
                "ENERGY_DRINK": { name: "Energy Drink", stack: 10, type: "FOOD", use: (p) => { p.stamina += 50; p.thirst += 10; return true; }},
                "COOKED_MEAT": { name: "Cooked Meat", stack: 10, type: "FOOD", use: (p) => { p.hunger += 50; return true; }},
                
                // T1 Medicine
                "BANDAGE": { name: "Bandage", stack: 20, type: "MEDICINE", use: (p) => { p.health += 10; return true; }},
                
                // T2 Medicine
                "FIRST_AID_KIT": { name: "First Aid Kit", stack: 5, type: "MEDICINE", use: (p) => { p.health += 50; return true; }},
                "PAINKILLERS": { name: "Painkillers", stack: 10, type: "MEDICINE", use: (p) => { p.health += 5; p.morale += 10; return true; }},
                
                // T3 Medicine
                "SURGICAL_KIT": { name: "Surgical Kit", stack: 1, type: "MEDICINE", use: (p) => { p.health += 100; return true; }},
                
